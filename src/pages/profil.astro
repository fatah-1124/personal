<style>
	.marquee-wrap {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
  }
  .marquee-content {
    display: inline-block;
    padding-left: 100%;
    animation: scroll-left 20s linear infinite;
  }
  .marquee-wrap:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes scroll-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>



