---
import Layout from '../layouts/Layout.astro';
---
<br>
<Layout
    title="Contoh Dashboard - R. M. Fatah Yasin"
    description="Contoh Dashboard Analisis Data"
>
<div class="page-layout">
	<div class="main-content">
		<div id="container">
			<main>
				<div class="container">	
					<div class="p-4 mb-2 bg-body border 10 border-card-highlight rounded">
						<div id="google_translate_element"></div>
						<div class="dropdown">
  							<button class="btn btn-primary dropdown-toggle" type="button" 
          							data-bs-toggle="dropdown" aria-expanded="false">
    								Menu
  							</button>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item" href="profil">Profil</a></li>
								<li><a class="dropdown-item" href="pendidikan">Pendidikan</a></li>
								<li><a class="dropdown-item" href="pekerjaan">Pekerjaan</a></li>
								<li><a class="dropdown-item" href="portfolio">Portfolio</a></li>
								<li><a class="dropdown-item" href="sertifikat">Sertifikat</a></li>
								<li><a class="dropdown-item" href="layanan">Produk & Layanan</a></li>
								<li><hr class="dropdown-divider"></li>
								<li><a class="dropdown-item" href="/kontak">Kontak</a></li>
							</ul>
						</div> <br>
						
						<h3>CONTOH DASHBOARD INTERAKTIF</h3>
						Analisis Keuangan Pribadi <br> <br>
						<div class="looker-embed-wrapper">
							<iframe src="https://datastudio.google.com/embed/reporting/9053d82e-cb45-428f-99d2-3c92932eeabb/page/5Po1F" frameborder="0" style="border:0" allowfullscreen sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
						</div> <br> <br>
						<section id="links">
							<a class="btn btn-dark" href="beranda">Kembali ke Beranda</a>
						</section>
					</div>
				</div>
			</main>
		</div>
	</div>
</div>
</Layout>
<style>
	.looker-embed-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 600 / 443;
  overflow: hidden;
}

.looker-embed-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}
	
</style>


