---
import { Image } from 'astro:assets';
const images = import.meta.glob('/src/images/sertifikat/*.{jpg,png,jpeg}', { eager: true });
import Layout from '../layouts/Layout.astro';
---
<Layout
    title="Sertifikat - R.M. Fatah Yasin"
    description="Beberapa sertifikat yang dimiliki R. M. Fatah Yasin"
>
<br><br>
<div class="page-layout">
	<div class="main-content">
		<div id="container">
			<main>
				<div class="container">	
					<div class="p-4 mb-2 bg-body rounded">
						<div class="dropdown">
  							<button class="btn btn-warning dropdown-toggle" type="button" 
          							data-bs-toggle="dropdown" aria-expanded="false">
    								Menu
  							</button>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item" href="profil">Profil</a></li>
								<li><a class="dropdown-item" href="pendidikan">Pendidikan</a></li>
								<li><a class="dropdown-item" href="pekerjaan">Pekerjaan</a></li>
								<li><a class="dropdown-item" href="sertifikat">Sertifikat</a></li>
								<li><a class="dropdown-item" href="layanan">Produk & Layanan</a></li>
								<li><hr class="dropdown-divider"></li>
								<li><a class="dropdown-item" href="/kontak">Kontak</a></li>
							</ul>
						</div> <br>
						
						<h3>SERTIFIKAT KETERAMPILAN</h3>
						<h4>Keterampilan utama :</h4>
						<ul>
							<li>Database Development</li>
							<li>Web Development</li>
							<li>Data Engineering & Analytics</li>
							<li>Data Visualization</li>
						</ul>
						<h4>Teknologi yang Digunakan :</h4>
						<ul>
							<li><a href="https://storage.googleapis.com/myskill-v2-certificates/course-WkXhzjw3nAeweAy7MiEg/GCae1qbgfRTzFpiGXiBEjrPTNTK2-znMLJnu2ieW4GKUZ7EwE.pdf" target="_blank"> Ms. Excel</a></li>
							<li>Ms. SQL Server</li>
							<li><a href="https://www.codepolitan.com/c/7JV1S4X/" target="_blank"> MySQL</a></li>
							<li><a href="https://storage.googleapis.com/myskill-v2-certificates/course-SJDuUB2kSc7lnxZWR6VO/GCae1qbgfRTzFpiGXiBEjrPTNTK2-JRXAoKYS63Fa08im8gFa.pdf" target="_blank"> Ms. Power BI</a></li>
							<li><a href="https://storage.googleapis.com/myskill-v2-certificates/course-YlWKAbWbTZZp6gDWjzGo/GCae1qbgfRTzFpiGXiBEjrPTNTK2-0mhaEDKIc8yIoP0pLCUr.pdf" target="_blank"> Google Data Studio</a></li>
							<li><a href="https://www.codepolitan.com/c/UM7WPWL/" target="_blank"> HTML</a></li>
							<li>CSS</li>
							<li>JavaScript</li>
							<li><a href="https://www.codepolitan.com/c/7OSDXN4/" target="_blank"> PHP</a></li>
							<li><a href="https://www.codepolitan.com/c/DEA9YFU/" target="_blank"> Bootstrap</a></li>
							<li>Laravel</li>
							<li><a href="https://www.codepolitan.com/c/Q5EFKI3/" target="_blank"> AstroJS</a></li>
							<li>ReactJS</li>
							<li><a href="https://academy.dqlab.id/certificate_check/result/DQLABINTP1JJMNNW#myjourney" target="_blank"> Python</a></li>
						</ul>
						<div class="grid">
							{Object.entries(images).map(([path, img]) => (
								<Image src={img.default} alt={path.split('/').pop()} />
							))}
						</div>
						<br><br>
						<section id="links">
							<a class="btn btn-warning" href="beranda">Kembali ke Beranda</a>
						</section>
					</div>
				</div>
			</main>
		</div>
	</div>
</div>
</Layout>
<style>
	.page-layout {
		display: flex;
		width: 100%;
	}

	.sidebar {
		flex: 0 0 auto;
	}

	.main-content {
		flex: 1 1 auto;
		min-width: 0; /* penting: biar grid di dalamnya bisa menyusut/melebar dengan benar */
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.0rem;
		width: 100%;
	}

	.grid img {
		width: 100%;
		height: auto;
		display: block;
	}
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

	
</style>


