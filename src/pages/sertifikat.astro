---
import { Image } from 'astro:assets';
const images = import.meta.glob('/src/images/sertifikat/*.{jpg,png,jpeg}', { eager: true });
import Layout from '../layouts/Layout.astro';
---
<Layout
    title="Sertifikat - DeepWater Solution"
    description="Beberapa sertifikat yang dimiliki R. M. Fatah Yasin"
>
<br>

<div class="page-layout">
	<div class="main-content">
		<div id="container">
			<main>
				<div class="container">	
					<div class="p-4 mb-2 bg-body border 10 border-card-highlight rounded">
						<div class="dropdown">
  							<button class="btn btn-primary dropdown-toggle" type="button" 
          							data-bs-toggle="dropdown" aria-expanded="false">
    								Menu
  							</button>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item" href="profil">Profil</a></li>
								<li><a class="dropdown-item" href="pendidikan">Pendidikan</a></li>
								<li><a class="dropdown-item" href="pekerjaan">Pekerjaan</a></li>
								<li><a class="dropdown-item" href="portfolio">Portfolio</a></li>
								<li><a class="dropdown-item" href="sertifikat">Sertifikat</a></li>
								<li><a class="dropdown-item" href="layanan">Produk & Layanan</a></li>
								<li><hr class="dropdown-divider"></li>
								<li><a class="dropdown-item" href="/kontak">Kontak</a></li>
							</ul>
						</div> <br>
						
						<h3>SERTIFIKAT KETERAMPILAN</h3>
						
						Berikut ini adalah beberapa sertifikat yang saya miliki, mewakili keterampilan saya di bidang : <br>
						<ul>
							<li>Computer Hardware Troubleshooting</li>
							<li>Computer Networking</li>
							<li>Graphic & Web Design</li>
							<li>Database Development</li>
							<li>Web Programming</li>
							<li>Data Analytics</li>
							<li>Business Intelligence</li>
							<li>Ship Machineries Maintenance</li>
						</ul>
						<div class="grid">
							{Object.entries(images).map(([path, img]) => (
								<Image src={img.default} alt={path.split('/').pop()} />
							))}
						</div>
						<br><br>
						<section id="links">
							<a class="btn btn-dark" href="beranda">Kembali ke Beranda</a>
						</section>
					</div>
				</div>
			</main>
		</div>
	</div>
</div>
</Layout>
<style>
	.page-layout {
		display: flex;
		width: 100%;
	}

	.sidebar {
		flex: 0 0 auto;
	}

	.main-content {
		flex: 1 1 auto;
		min-width: 0; /* penting: biar grid di dalamnya bisa menyusut/melebar dengan benar */
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.0rem;
		width: 100%;
	}

	.grid img {
		width: 100%;
		height: auto;
		display: block;
	}
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

	
</style>


