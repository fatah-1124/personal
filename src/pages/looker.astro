---
import Layout from '../layouts/Layout.astro';
---
<br>
<Layout
    title="Contoh Dashboard - R. M. Fatah Yasin"
    description="Dashboard Analisis Keuangan untuk sektor maritim dan logistik, oleh R. M. Fatah Yasin."
>
<div class="page-layout">
	<div class="main-content">
		<div id="container">
			<main>
				<div class="container">	
					<div class="p-4 mb-2 bg-body border 10 border-card-highlight rounded">
						<div class="dropdown">
  							<button class="btn btn-primary dropdown-toggle" type="button" 
          							data-bs-toggle="dropdown" aria-expanded="false">
    								Menu
  							</button>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item" href="profil">Profil</a></li>
								<li><a class="dropdown-item" href="pendidikan">Pendidikan</a></li>
								<li><a class="dropdown-item" href="pekerjaan">Pekerjaan</a></li>
								<li><a class="dropdown-item" href="portfolio">Portfolio</a></li>
								<li><a class="dropdown-item" href="sertifikat">Sertifikat</a></li>
								<li><a class="dropdown-item" href="layanan">Produk & Layanan</a></li>
								<li><hr class="dropdown-divider"></li>
								<li><a class="dropdown-item" href="/kontak">Kontak</a></li>
							</ul>
						</div> <br>
						
						<h3>Dashboard Konsumsi Bahan Bakar</h3>
						<h4>(Bisa dibuka di komputer atau smartphone)</h4>
						<div class="container">
							<div class="p-4 mb-2 bg-body rounded">
								<h2>Halaman ini sedang dalam proses pengembangan</h2>
							</div>
						</div>
						<br>
						<section id="links">
							<a class="btn btn-dark" href="beranda">Kembali ke Beranda</a>
						</section>
					</div>
				</div>
			</main>
		</div>
	</div>
</div>
</Layout>
<style>
	.looker-embed-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 600 / 443;
  overflow: hidden;
}

.looker-embed-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}
	
</style>


