	</body>

<style>
	.karya-container {
		background-color: rgb(8, 8, 105);
		width: min(100% - 2rem, 1100px);
		margin: 2rem auto;
		position: relative;
		overflow: hidden;
	}

	.artikel-container {
		width: min(100% - 2rem, 1300px);
		margin: 2rem auto;
	}
	.hero-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 3px;
	}
	.hero-frame {
    border: 1px solid rgba(192, 138, 62, 0.4);
    padding: 0.3rem;
    border-radius: 6px;
  }
</style>
		
	
