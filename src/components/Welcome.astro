---
import HeaderAstroComponent from '../components/Header.astro';
import { getCollection } from 'astro:content';
import '../components/Card.astro';
// 1. Ambil semua data koleksi 'blog'
const blogPosts = await getCollection('blog');
import Hero from '../components/Hero.astro';

---
<HeaderAstroComponent>
</HeaderAstroComponent>

	<body>
		<Hero />
		<section id="karya" class="karya-container">
			<div class="p-4 mb-2 bg-white border text-center rounded">
			<h2>Contoh Hasil Karya</h2>
			<br>
			<div class="d-flex flex-column flex-sm-row gap-3">
				<a class="btn btn-primary" href="looker" role="button">Dashboard Analisis Konsumsi Bahan Bakar</a>
				<a class="btn btn-primary" href="https://softdemo-production.up.railway.app" role="button">Sistem Manajemen Stok</a>
				<a class="btn btn-primary" href="/cvFatah" role="button">CV Online Khusus Pelaut</a>
				<a class="btn btn-primary" href="powerBI" role="button">Dashboard Analisis Keuangan</a>
				<a class="btn btn-primary" href="#" role="button">IndoSeaman - MaritimeApp</a>
			</div>
			</div>
		</section>
		
		<section id="artikel" class="artikel-container">
				<br>
				<div class="p-4 mb-2 bg-white rounded">
					<h2>Daftar Artikel</h2>
					<main>
						<div>
							<ul>
								{
									blogPosts.map((post) => (
									<li>
									<a href={`/blog/${post.id}`}>
										{post.data.title ?? 'Tanpa Judul'}
									</a>
									</li>
								))
								}
							</ul>
						</div>
					</main>
				</div> 
		</section>
	</body>

<style>
	.karya-container {
		width: min(100% - 2rem, 1300px);
		margin: 2rem auto;
	}

	.artikel-container {
		width: min(100% - 2rem, 1300px);
		margin: 2rem auto;
	}
</style>
		
	
