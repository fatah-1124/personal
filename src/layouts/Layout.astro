---
interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'R.M. Fatah Yasin - Full-Stack Developer',
    description = 'Solusi sistem informasi untuk sektor maritim dan logistik, oleh R. M. Fatah Yasin.',
} = Astro.props;
import '../assets/css/app.css';
import '../assets/css/global.css';
import HeaderAstroComponent from '../components/Header.astro';
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		<script is:inline type="text/javascript">
		function googleTranslateElementInit() {
			new google.translate.TranslateElement(
			{
				pageLanguage: 'id',
				includedLanguages: 'en,id,ja,ko,fr,es,de',
				layout: google.translate.TranslateElement.InlineLayout.SIMPLE
			},
			'google_translate_element'
			);
		}
		</script>

		<script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    </head>
    <body>
		<HeaderAstroComponent />
		<slot />
        <footer class="bg-dark text-white text-center p-1 mt-5">
            <p>
                Copyright &copy; 2026 || R. M. Fatah Yasin || developed with <a href="https://www.astro.build">AstroJS</a>
            </p>
        </footer>
    </body>
</html>
<style>
	
	.page-layout {
		display: flex;
		width: 100%;
	}

	.sidebar {
		flex: 0 0 auto;
	}

	.main-content {
		flex: 1 1 auto;
		min-width: 0; /* penting: biar grid di dalamnya bisa menyusut/melebar dengan benar */
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.0rem;
		width: 100%;
	}

	.grid img {
		width: 100%;
		height: auto;
		display: block;
	}
	
</style>