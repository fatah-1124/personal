---
interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'DeepWater Solution - Web Developer & BI Analyst Maritim',
    description = 'Solusi digital dan analisis data terpadu untuk sektor maritim dan logistik, oleh R. M. Fatah Yasin.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <!-- <link rel="stylesheet" href="../assets/css/app.css">
        <link rel="stylesheet" href="../assets/css/style.css"> -->
        <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </head>
    <body>
        <slot />
        <footer class="bg-dark text-white text-center p-1 mt-5">
            <p>
                Copyright &copy; 2026 || R. M. Fatah Yasin || developed with <a href="https://www.astro.build">AstroJS</a>
            </p>
        </footer>
    </body>
</html>