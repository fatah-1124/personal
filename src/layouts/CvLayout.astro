---
interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'R.M. Fatah Yasin - Engine Rating',
    description = 'Curriculum Vitae',
} = Astro.props;
import '../assets/css/app.css';
import '../assets/css/style.css';
import HeaderAstroComponent from '../components/CVNavbar.astro';
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		<script is:inline type="text/javascript">
		function googleTranslateElementInit() {
			new google.translate.TranslateElement(
			{
				pageLanguage: 'id',
				includedLanguages: 'en,id,ja,ko,fr,es,de',
				layout: google.translate.TranslateElement.InlineLayout.SIMPLE
			},
			'google_translate_element'
			);
		}
		</script>

		<script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    </head>
    <body>
		<HeaderAstroComponent />
		<slot />
        
        <footer class="bg-dark text-white text-center p-1 mt-5">
            <p>
                Supported by :  <a class="btn btn-light" href="/beranda">DeepWater Solution</a>
            </p>
        </footer>
    </body>
</html>
<style>
	body {
	margin-top: 60px;
	}
	.page-layout {
		display: flex;
		width: 100%;
	}

	.sidebar {
		flex: 0 0 auto;
	}

	.main-content {
		flex: 1 1 auto;
		min-width: 0; /* penting: biar grid di dalamnya bisa menyusut/melebar dengan benar */
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.0rem;
		width: 100%;
	}

	.grid img {
		width: 100%;
		height: auto;
		display: block;
	}
	
</style>